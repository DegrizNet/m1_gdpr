<?php if ($this->getIsActive()):

    $rnd_str = substr(md5(uniqid('', true)), 0, 8);

?>
	<div class="degriz_gdprnewsletter gdprnewsletter_<?php echo $rnd_str; ?>">
		<div class="gdpr_line"><?php echo $this->getText() ?>	<a href="javascript:void(0)" class="gdprnewsletter_box_open"><label class="gdprlabel_text" for="gdprpopup_<?php echo $rnd_str; ?>"><?php echo $this->getLink() ?></label></a></div>
		<input class="gdprpopup-state" id="gdprpopup_<?php echo $rnd_str; ?>" type="checkbox" />
		<div class="gdprpopup_class">
			<label class="gdprpopup_bg" for="gdprpopup_<?php echo $rnd_str; ?>"></label>
			<div class="gdprpopup_inner">
				<div>
					<label class="gdprpopup_close" for="gdprpopup_<?php echo $rnd_str; ?>"></label>
			        <div class="gdprpopup_box_inner std">
						<?php echo $this->getMessage() ?>
			        </div>
			        <div class="gdprpopup_box_subscribe">
			            <div class="gdprpopup_box_subscribe_form">
							<a class="button" href="javascript:void(0)"><label class="gdprlabel_button gdprpopup_yes" for="gdprpopup_<?php echo $rnd_str; ?>"><?php echo $this->__('Yes, I agree'); ?></label></a>
							<a class="button" href="javascript:void(0)"><label class="gdprlabel_button gdprpopup_no" for="gdprpopup_<?php echo $rnd_str; ?>"><?php echo $this->__("No, i don't agree"); ?></label></a>
			            </div>
			        </div>
		        </div>
			</div>
		</div>
	</div>
<script type="text/javascript">
(function () {
    var block = document.querySelector('.gdprnewsletter_<?php echo $rnd_str; ?>');
    var input = document.querySelector('input[name="is_subscribed"]');
    if (!block || !input) return;
    function toggle(state) {
        input.checked = state;
        input.dispatchEvent(new Event('change', { bubbles: true }));
    }
    block.querySelector('.gdprpopup_yes').addEventListener('click', function () { toggle(true); });
    block.querySelector('.gdprpopup_no').addEventListener('click', function () { toggle(false); });
    block.querySelector('.gdprpopup-state').addEventListener('change', function () {
        document.documentElement.classList.toggle('modal_opened');
        document.body.classList.toggle('modal_opened');
        block.querySelector('.gdprpopup_class').classList.toggle('popup_opened');
    });
})();
</script>
<?php endif; ?>